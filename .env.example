# ROADIX Environment Configuration Template
# Copy this file to .env.local or .env in development.
# Never commit real secrets or service-role keys to version control.

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Map & Geolocation Services
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Cloudinary Asset Delivery & Management
CLOUDINARY_CLOUD_NAME=kefzjqi3
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-cloudinary-api-key:your-cloudinary-api-secret@kefzjqi3

# Environment
ENVIRONMENT=development
