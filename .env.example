# ROADIX Environment Configuration Template
# Copy to `.env` for local build injection via `--dart-define-from-file=.env`.
# Never commit `.env` or secret keys to version control, and NEVER pass server
# payment secrets (SSLCommerz store_passwd, service_role, Cloudinary API secret)
# into client app bundles — set those via `supabase secrets set`.

# Supabase Public Client Configuration (supports EXPO_PUBLIC_*, ROADIX_*, or SUPABASE_*)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Map & Geolocation Services (Optional Geoapify override; free OpenFreeMap + Nominatim used when omitted)
EXPO_PUBLIC_GEOAPIFY_API_KEY=
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Google OAuth Client IDs (Optional client metadata; Supabase OAuth uses dashboard Google provider)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Cloudinary Public Cloud Name (never embed API keys/secrets in client APK)
CLOUDINARY_CLOUD_NAME=kefzjqi3
# Server/CLI only (kept empty in client builds):
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# SSLCommerz Gateway Mode (non-secret flag; set SSLCOMMERZ_STORE_ID & SSLCOMMERZ_STORE_PASSWD via Supabase Edge Secrets)
SSLCOMMERZ_IS_SANDBOX=true

# Environment
ENVIRONMENT=development
